# --- Secretos. Nunca al repositorio ---
# Certificado de desarrollo exportado: localhost.key es una clave privada.
# Se regenera cuando haga falta con:
#   dotnet dev-certs https --export-path certificados/localhost.pem --format PEM --no-password
certificados/
.clave-pg.txt
.env
*.env
!.env.example
# appsettings.Development.json SI se versiona: son decisiones de producto para
# desarrollo, sin secretos. Los secretos van en User Secrets.
appsettings.Production.json

# --- La instancia local de PostgreSQL vive dentro del proyecto ---
herramientas/
datos-pg/
registros/

# --- .NET ---
bin/
obj/
*.user

# --- Node ---
node_modules/
dist/
.vite/
.worktrees/

# --- Archivos subidos en desarrollo ---
almacenamiento/
buzon-correo/
