{
  // Decisiones de PRODUCTO para desarrollo, no secretos. Nada de claves ni cadenas de
  // conexion aqui: eso va en User Secrets (`dotnet user-secrets`), que no se versiona.
  //
  // Este archivo SI se versiona, a proposito: antes estaba en .gitignore y la fusion de
  // agente/verificacion lo trajo igual, dejandolo rastreado-e-ignorado, que es lo peor de
  // los dos mundos (git deja de respetar el ignore y nadie lo sabe). Solo carga en el
  // entorno Development, asi que produccion nunca lo ve.
  "Zass": {
    // Mientras MOD-08 (archivos) no exista, nadie puede adjuntar el respaldo de una
    // credencial: en desarrollo se permite enviar a revision sin documentos para poder
    // recorrer MOD-02 entero. Por omision es false en el codigo, y produccion usa eso.
    "Verificacion": {
      "PermitirSinDocumentos": true
    },
    // Las pruebas de navegador y el uso a mano salen todos de 127.0.0.1 y comparten cupo:
    // con los valores reales (5 y 10) se choca con el 429 al segundo intento.
    "Tasa": {
      "A": 1000,
      "S": 1000
    }
  }
}
